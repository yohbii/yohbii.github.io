---
import VisitorMap from "@/components/VisitorMap.astro";
import {
  awards,
  experiences,
  news,
  profile,
  projects,
  selectedPublications,
  site
} from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="home-shell">
    <section class="hero" aria-labelledby="home-title">
      <div>
        <h1 id="home-title">{site.name}</h1>
        <p class="lede">
          👋 Hi, I am an undergraduate student in Software Engineering at
          <a href="https://www.neu.edu.cn/" target="_blank" rel="noreferrer">
            Northeastern University
          </a>
          and a research intern at the
          <a href="https://henghuiding.com" target="_blank" rel="noreferrer">
            FudanCVL Lab
          </a>
          led by Prof. Henghui Ding. My research interests include computer
          vision, AIGC, world models, and multimodal understanding.
        </p>
      </div>
      <aside class="profile-panel" aria-labelledby="profile-title">
        <h2 id="profile-title">Links</h2>
        <p>
          You can find more information about me through the links below.
        </p>
        <ul class="link-row" aria-label="Profile links">
          {profile.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </aside>
    </section>

    <section class="section-grid section" aria-labelledby="interests-title">
      <h2 id="interests-title">Research interests</h2>
      <ul class="interest-list">
        {profile.interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </section>

    <section class="section-grid section" aria-labelledby="publications-title">
      <div class="section-heading">
        <h2 id="publications-title">Selected publications</h2>
        <a
          href="https://scholar.google.com/citations?user=OeHnALIAAAAJ&hl=zh-CN&authuser=1"
          target="_blank"
          rel="noreferrer"
        >
          Full List
        </a>
      </div>
      {
        selectedPublications.length > 0 ? (
          <div class="work-list">
            {selectedPublications.map((work) => (
              <article class="work-item">
                <p class="meta-line">{work.venue} / {work.year}</p>
                <div>
                  <h3>{work.title}</h3>
                  <p>{work.description}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="section-note">
            The work I hope to contribute will appear here in time.
          </p>
        )
      }
    </section>

    <section class="section-grid section" aria-labelledby="news-title">
      <h2 id="news-title">News</h2>
      {
        news.length > 0 ? (
          <div class="work-list">
            {news.map((item) => (
              <article class="work-item">
                <p class="meta-line">{item.date}</p>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="section-note">News will appear here soon.</p>
        )
      }
    </section>

    <section class="section-grid section" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      {
        experiences.length > 0 ? (
          <div class="work-list">
            {experiences.map((item) => (
              <article class="work-item">
                <p class="meta-line">{item.period}</p>
                <div>
                  <h3>{item.role}</h3>
                  <p>{item.organization}</p>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="section-note">Experience details will be added here soon.</p>
        )
      }
    </section>

    <section class="section-grid section" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      {
        projects.length > 0 ? (
          <div class="work-list">
            {projects.map((item) => (
              <article class="work-item">
                <p class="meta-line">Project</p>
                <div>
                  <h3>
                    {item.href ? <a href={item.href}>{item.title}</a> : item.title}
                  </h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="section-note">-</p>
        )
      }
    </section>

    <section class="section-grid section" aria-labelledby="award-title">
      <h2 id="award-title">Award</h2>
      {
        awards.length > 0 ? (
          <div class="work-list">
            {awards.map((item) => (
              <article class="work-item">
                <p class="meta-line">{item.year}</p>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.issuer}</p>
                  {item.description && <p>{item.description}</p>}
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="section-note">-</p>
        )
      }
    </section>

    <VisitorMap />
  </div>
</BaseLayout>
