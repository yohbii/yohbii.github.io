---
import ProfileIcon from "@/components/ProfileIcon.astro";
import VisitorMap from "@/components/VisitorMap.astro";
import { awards, experiences, news, profile, projects, selectedPublications, site } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const icons = { Email: "email", GitHub: "github", "Google Scholar": "scholar" } as const;
const scholarUrl = profile.links.find((link) => link.label === "Google Scholar")!.href;
---
<BaseLayout>
  <div class="academic-layout">
    <header id="profile" class="identity">
      <img class="profile-photo" src="/avatar.jpg" alt="Lihong Lin's profile avatar" width="144" height="144" fetchpriority="high" />
      <div class="identity-copy">
        <h1>{site.name}</h1>
        <p class="profile-field">Robotics · Generative Modeling · World Models</p>
        <ul class="profile-links" aria-label="Contact and profiles">
          {profile.links.map((link) => (
            <li><a href={link.href}>
              <ProfileIcon name={icons[link.label as keyof typeof icons] ?? "arrow"} size={18} />
              <span>{link.label}</span>
            </a></li>
          ))}
        </ul>
      </div>
    </header>

    <section id="about" class="academic-section about-section" aria-labelledby="about-title">
      <h2 id="about-title">About me</h2>
      <p>I am an undergraduate student in Software Engineering at <a href="https://www.neu.edu.cn/">Northeastern University</a> and an incoming Ph.D. student at <a href="https://henghuiding.com/">FudanCVL Lab</a>, advised by <a href="https://henghuiding.com/">Prof. Henghui Ding</a>.</p>
      <p>I am also a research intern in the Robotics Group at <a class="inline-organization" href="https://longcat.ai/"><img src="/logos/longcat.svg" alt="" width="19" height="19" />Meituan LongCat</a>.</p>
      <p>My research focuses on <strong>robotics</strong>, <strong>generative modeling</strong>, and <strong>world models</strong>, with an interest in embodied intelligence.</p>
    </section>

    <section id="news" class="academic-section" aria-labelledby="news-title">
      <div class="section-title"><h2 id="news-title">News</h2></div>
      <ul class="news-list">
        {news.map((item) => (
          <li><span class="news-date">{item.date}</span><span>{item.description}</span></li>
        ))}
      </ul>
    </section>

    <section id="experience" class="academic-section" aria-labelledby="experience-title">
      <div class="section-title"><h2 id="experience-title">Experience &amp; Education</h2></div>
      <div class="experience-list">
        {experiences.map((item) => (
          <article class="experience-entry">
            <a class="organization-logo" href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.organization} website`}>
              <img src={item.logo} alt="" width="48" height="48" loading="lazy" />
            </a>
            <div class="experience-body">
              <h3><a href={item.href} target="_blank" rel="noreferrer">{item.organization}<ProfileIcon name="arrow" size={12} /></a></h3>
              <p class="experience-period">{item.period}</p>
              <p class="experience-role">{item.role}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="publications" class="academic-section" aria-labelledby="publications-title">
      <div class="section-title"><h2 id="publications-title">Publications</h2></div>
      {selectedPublications.length > 0 ? (
        <div class="publication-list">
          {selectedPublications.map((paper) => <article><h3>{paper.title}</h3><p class="detail">{paper.venue} · {paper.year}</p><p>{paper.description}</p></article>)}
          <a href={scholarUrl}>Full list on Google Scholar ↗</a>
        </div>
      ) : (
        <a class="scholar-link" href={scholarUrl}>
          <span class="scholar-symbol"><ProfileIcon name="scholar" size={25} /></span>
          <span><strong>Google Scholar</strong><span class="detail">Publications &amp; citations</span></span>
          <ProfileIcon name="arrow" size={17} />
        </a>
      )}
    </section>
    {projects.length > 0 && <section class="academic-section"><h2>Projects</h2>{projects.map((project) => <article><h3>{project.href ? <a href={project.href}>{project.title}</a> : project.title}</h3><p>{project.description}</p></article>)}</section>}
    {awards.length > 0 && <section class="academic-section"><h2>Awards</h2>{awards.map((award) => <article><h3>{award.title}</h3><p>{award.issuer} · {award.year}</p></article>)}</section>}
    <VisitorMap />
  </div>
</BaseLayout>
