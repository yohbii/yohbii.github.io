---
type Props = { name: "email" | "github" | "scholar" | "arrow"; size?: number };
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "email" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></>}
  {name === "github" && <><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.2-1.5 6.2-6.8a5.3 5.3 0 0 0-1.4-3.7 5 5 0 0 0-.1-3.7s-1.1-.3-3.8 1.4a13 13 0 0 0-7 0C5.3.2 4.2.5 4.2.5A5 5 0 0 0 4.1 4a5.3 5.3 0 0 0-1.4 3.7c0 5.3 3.2 6.5 6.2 6.8A3.4 3.4 0 0 0 8 17.2v4.1" transform="translate(1 1) scale(.9)" /></>}
  {name === "scholar" && <><path d="m2 9 10-5 10 5-10 5-10-5Z" /><path d="M6 11v6c3 2.7 9 2.7 12 0v-6M22 9v7" /></>}
  {name === "arrow" && <path d="M6 18 18 6M6 6h12v12" />}
</svg>
