---
import { categoryLabels, formatDate, getPostUrl, type BlogPost } from "@/lib/blog";

type Props = {
  posts: BlogPost[];
  title?: string;
};

const { posts, title } = Astro.props;
---

<section class="post-list-section" aria-labelledby={title ? "post-list-title" : undefined}>
  {title && <h2 id="post-list-title">{title}</h2>}
  <div class="post-list">
    {
      posts.map((post) => (
        <article class="post-item">
          <div class="post-kicker">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </div>
          <div class="post-main">
            {post.data.cover && (
              <a class="post-cover" href={getPostUrl(post)} aria-label={`Read ${post.data.title}`}>
                <img
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? ""}
                  loading="lazy"
                  width="720"
                  height="405"
                />
              </a>
            )}
            <h3>
              <a href={getPostUrl(post)}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
            <div class="post-taxonomy">
              <a href={`/blog/category/${post.data.category}/`}>
                {categoryLabels[post.data.category]}
              </a>
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
