---
// The dashboard's map token also works with the globe endpoint. Its globe
// generator returned an unusable token for this same statistics record.
const defaultGlobeUrl = "https://mapmyvisitors.com/globe.js?d=1xMPxAEEcj3q_RPyNEZHhY7sDF6jhYeUw6NjMPUqHFU";
const globeUrl = import.meta.env.PUBLIC_VISITOR_GLOBE_URL || defaultGlobeUrl;
const statisticsUrl = import.meta.env.PUBLIC_VISITOR_STATS_URL ||
  (globeUrl === defaultGlobeUrl ? "https://mapmyvisitors.com/web/1c8jn" : undefined);
---
<section class="visitor-map" aria-labelledby="visitors-title">
  <h2 id="visitors-title">Visitors</h2>
  <div class="visitor-map-widget" data-visitor-widget>
    <script is:inline async id="mmvst_globe" src={globeUrl}></script>
  </div>
  <p class="visitor-status" data-visitor-status aria-live="polite">Loading visitor map…</p>
  <a data-visitor-statistics href={statisticsUrl} hidden={!statisticsUrl} target="_blank" rel="noreferrer">Visitor statistics ↗</a>
  <noscript><p class="visitor-status">Enable JavaScript to view the visitor map.</p></noscript>
</section>
<script>
  const widget = document.querySelector<HTMLElement>("[data-visitor-widget]");
  const status = document.querySelector<HTMLElement>("[data-visitor-status]");
  const statistics = document.querySelector<HTMLAnchorElement>("[data-visitor-statistics]");
  if (widget && status) {
    function unavailable() {
      if (!widget || !status) return;
      widget.hidden = true;
      status.hidden = false;
      status.textContent = "Visitor data is temporarily unavailable.";
    }

    const observer = new MutationObserver(check);
    const timeout = window.setTimeout(unavailable, 12000);

    function check() {
      if (!widget || !status) return;
      // The globe shell loads even when the data request fails. The provider
      // sets this site-specific link only after its JSONP response succeeds.
      const link = widget.querySelector<HTMLAnchorElement>("#mmvst_a[href]");
      if (!link) return;
      const url = new URL(link.href);
      if (url.hostname !== "mapmyvisitors.com" || !/^\/web\/[a-z0-9]+\/?$/.test(url.pathname)) return;

      widget.hidden = false;
      const hasLocations = Boolean(widget.querySelector(".svg_points circle"));
      status.hidden = hasLocations;
      status.textContent = "No visitor locations available yet.";
      if (statistics) {
        url.protocol = "https:";
        statistics.href = url.href;
        statistics.hidden = false;
      }
      window.clearTimeout(timeout);
      if (hasLocations) observer.disconnect();
    }
    // Ignore the animation's continuous style changes; keep listening after
    // a timeout so a slow data response can still restore the widget.
    observer.observe(widget, { childList: true, subtree: true, attributeFilter: ["href"] });
    document.getElementById("mmvst_globe")?.addEventListener("error", () => {
      unavailable();
      window.clearTimeout(timeout);
    });
    check();
  }
</script>
