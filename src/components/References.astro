---
import type { BibliographyEntry } from "@/lib/bibliography";
import { formatReference } from "@/lib/bibliography";

type Props = {
  entries: BibliographyEntry[];
};

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="references" aria-labelledby="references-title">
      <h2 id="references-title">References</h2>
      <ol>
        {entries.map((entry) => (
          <li id={`ref-${entry.key}`}>
            <span>{formatReference(entry)}</span>
            {entry.doi && (
              <>
                {" "}
                <a href={`https://doi.org/${entry.doi}`}>doi:{entry.doi}</a>
              </>
            )}
            {!entry.doi && entry.url && (
              <>
                {" "}
                <a href={entry.url}>Link</a>
              </>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
